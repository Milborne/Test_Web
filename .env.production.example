NODE_ENV=production
APP_ORIGIN=https://app.game2web.app
PLAYER_ORIGIN=https://play.game2web.app
NEXT_PUBLIC_PLAYER_ORIGIN=https://play.game2web.app
PREVIEW_APP_ORIGIN=https://app.game2web.app
PREVIEW_PERSISTENT=false
PREVIEW_STORAGE_DURABLE=false
PREVIEW_TTL_HOURS=24
DEPLOYMENT_PROVIDER=public
DATABASE_URL=postgresql://<private-host>/<database>
REDIS_URL=rediss://<private-host>
S3_ENDPOINT=https://<private-private-bucket-endpoint>
S3_BUCKET=game2web-private
S3_ACCESS_KEY=<secret-manager-reference>
S3_SECRET_KEY=<secret-manager-reference>
MAX_PROJECTS=25
MAX_CONCURRENT_BUILDS=4
MAX_CONCURRENT_BUILDS_PER_USER=2
BUILD_MIN_FREE_DISK_MB=16384
